{
  "appId": "com.mstock.admin",
  "productName": "Mstock Admin Dashboard",
  "directories": {
    "output": "dist_admin"
  },
  "files": [
    "admin/**/*",
    "node_modules/**/*"
  ],
  "main": "admin/main.js",
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Mstock-Admin-Setup-${version}.${ext}"
  }
}
